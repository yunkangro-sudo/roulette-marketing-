# ============================================================
# 환경변수 템플릿 - 절대 커밋 금지 (.env.local 에 값 입력)
# ============================================================

# ----- Supabase -----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----- 데이터베이스 (Supabase Postgres 직접 연결) -----
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ----- 인증 -----
AUTH_SECRET=your-random-32-char-secret-here

# ----- 카카오 OAuth / 알림톡 -----
NEXT_PUBLIC_KAKAO_JS_KEY=      # 카카오 앱 - JavaScript 키 (로그인 SDK)
KAKAO_CLIENT_SECRET=           # 카카오 앱 - 보안 > 클라이언트 시크릿 (선택, 설정 권장)
KAKAO_REST_API_KEY=            # REST API 키 (서버측 API 호출용)
KAKAO_CHANNEL_PUBLIC_ID=       # 카카오톡 채널 공개 ID
KAKAO_ALIMTALK_SENDER_KEY=     # 알림톡 발송대행사에서 발급한 Sender Key

# ----- 전화번호 보호 (docs/_archive/04-data-api-security.md 3장, docs/migrations/017_phone_alimtalk.sql 참고) -----
PHONE_ENCRYPTION_KEY=
PHONE_HASH_SALT=

# ----- 카카오 심사 대기 임시 우회 (카카오 심사 완료 후 반드시 삭제/false) -----
# TEMP: 카카오 심사 대기용 임시 우회 - 심사 승인 후 제거
# true면 화면 3 [카카오로 결과 확인하기]가 실제 OAuth 대신 test-user-1 mock 세션으로 claim
NEXT_PUBLIC_KAKAO_REVIEW_PENDING=false

# ----- 데모 버전 안내 (게임 랜딩 화면 하단) -----
# 값을 채우면 "광고주 상담 문의하기" 링크가 랜딩 화면에 표시됨 (카카오톡 채널/오픈채팅 URL). 비우면 숨김.
NEXT_PUBLIC_ADVERTISER_KAKAO_URL=

# ----- 데모 버전 전용: 1일 1회 참여 제한 해제 (실서비스 전환 시 반드시 false/삭제) -----
# true면 같은 카카오 계정으로 몇 번이든 다시 뽑기 가능 (광고주 시연/테스트용)
DEMO_UNLIMITED_PLAY=false

# ----- Vercel Cron 보안 토큰 (Vercel 환경변수에 임의 문자열 설정) -----
# 크론 엔드포인트 보호용 — 로컬 테스트 시에도 이 값으로 Authorization 헤더 전송
CRON_SECRET=your-random-cron-secret-here
